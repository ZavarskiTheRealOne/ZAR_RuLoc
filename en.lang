# - sharing game choices (usage.odin): the one-time two-step prompt and the settings
# screen's PRIVACY tab, which shows step two word for word. usage.q2_body is the whole of
# step two, broken into lines with \n: keep each line within 48 characters and the whole within
# 11 lines (the PRIVACY tab prints them as they are, one per row). \n\n is a blank line.
usage.q1 = Would you like to help shape the future balance\nand content of Zombies Aren't Real?
usage.q2_title = Share Your Game Choices?
usage.q2_body = Turning this on sends me the choices you make\nin each battle: the units, upgrades and\nabilities you pick, the level, and how it\nturned out. Seeing what players choose helps me\ndevelop the game and keep it balanced.\n\nNo sensitive data is sent: no name, no Steam ID,\nno location and nothing you type. Your game is\nknown only by a random ID it makes for itself.\n\nYou can change this any time in Settings.
usage.share = SHARE GAME CHOICES
usage.dont_share = DON'T SHARE
usage.privacy_policy = PRIVACY POLICY
usage.thanks = Thank you! Your game choices will help balance the game.
usage.no_browser = Couldn't open the privacy policy
usage.policy_file = It is PRIVACY_POLICY.html, in the game's folder.
